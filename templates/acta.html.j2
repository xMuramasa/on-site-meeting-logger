<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Acta {{ acta.meeting.title }} — {{ acta.meeting.long_date() }}</title>
<style>
:root { --background: #ffffff; --foreground: {{ branding.colors.foreground }}; --primary: {{ branding.colors.primary }}; --primary-foreground: {{ branding.colors.primary_foreground }}; --muted: {{ branding.colors.muted }}; --muted-foreground: {{ branding.colors.muted_foreground }}; --border: {{ branding.colors.border }}; }
* { box-sizing: border-box; }
html { background: var(--muted); }
body { margin: 0 auto; width: 8.5in; min-height: 11in; padding: 1in; background: var(--background); color: #404040; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 11pt; line-height: 1.42; box-shadow: 0 8px 30px rgba(0,0,0,.10); }
.masthead { display: flex; align-items: center; height: 32px; margin-bottom: 7px; }
.title { color: var(--foreground); font-size: 15pt; font-weight: 700; }
.rule { height: 2px; background: var(--primary); margin-bottom: 10px; }
.meta { display: flex; gap: 10px; flex-wrap: wrap; padding: 6px 9px; background: var(--muted); font-size: 10pt; margin-bottom: 10px; }
.meta strong, strong { color: #444; }
.participants-title { color: var(--foreground); font-size: 12pt; font-weight: 700; margin: 7px 0 3px; }
.note { font-size: 9.3pt; color: #777; margin: 2px 0 8px; }
table { width: 100%; border-collapse: collapse; margin: 5px 0 16px; font-size: 10.2pt; }
th { background: var(--primary); color: var(--primary-foreground); padding: 5px 9px; text-align: left; }
td { padding: 4px 9px; vertical-align: top; }
tbody tr:nth-child(odd) { background: var(--muted); }
.context, .callout { border-left: 5px solid var(--primary); background: var(--muted); padding: 8px 11px; margin: 10px 0 16px; }
.section { margin: 14px 0 6px; }
.section-title { color: var(--foreground); background: var(--muted); border-left: 4px solid var(--primary); font-size: 12pt; font-weight: 700; padding: 4px 9px; margin: 0 0 7px; break-after: avoid; }
p { margin: 0 15px 7px; }
.time { color: var(--muted-foreground); white-space: nowrap; font-size: 9.3pt; }
.task { margin: 5px 15px; }
.task-label { color: var(--foreground); font-weight: 700; }
.owner { color: var(--muted-foreground); }
.callout h2 { color: var(--foreground); font-size: 11.5pt; margin: 0 0 5px; }
ul { margin: 3px 0 0 17px; padding: 0; }
li { margin: 3px 0; }
.source-note { border-top: 1px solid var(--border); padding-top: 7px; color: var(--muted-foreground); font-size: 8.7pt; margin-top: 16px; break-inside: avoid; }
.confidential { margin-top: 6px; font-size: 9pt; }
.print-footer { display: none; }
@page { size: Letter; margin: 1in; }
@media print { html { background: white; } body { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; -webkit-print-color-adjust: exact; print-color-adjust: exact; } table, .context, .callout { break-inside: avoid; } .section-title { break-after: avoid; } p, .task { orphans: 3; widows: 3; } .print-footer { display: block; position: fixed; bottom: -0.72in; left: 0; right: 0; color: var(--muted-foreground); font-size: 8pt; text-align: center; } .page-number::after { content: counter(page); } }
</style>
</head>
<body>
<header class="masthead">{% if branding.logo_svg %}<div class="logo-svg">{{ branding.logo_svg | safe }}</div>{% endif %}<div class="title">{{ branding.logo_text or branding.organization_name or "ACTA DE REUNIÓN" }}</div></header>
<div class="rule"></div>
<div class="meta"><span><strong>Reunión:</strong> {{ acta.meeting.title }}</span><span>|</span><span><strong>Fecha:</strong> {{ acta.meeting.long_date() }}</span><span>|</span><span><strong>Lugar:</strong> {{ acta.meeting.location }}</span></div>
<div class="participants-title">Participantes</div>
<p class="note">{{ acta.participants_note }}</p>
<table><thead><tr><th>Participante</th><th>Correo</th><th>Asistencia</th></tr></thead><tbody>
{% for participant in acta.participants -%}
<tr><td>{{ participant.name }}</td><td>{{ participant.email or "—" }}</td><td>{{ "Confirmada" if participant.attendance == "confirmed" else "Por confirmar" }}</td></tr>
{% endfor -%}
</tbody></table>
{% if acta.continuity_note %}<div class="context"><strong>Contexto de continuidad.</strong> {{ acta.continuity_note }}</div>{% endif %}
{% for section in acta.sections %}
<section class="section"><h2 class="section-title">{{ section.number }}. {{ section.title }}</h2>
{% for paragraph in section.paragraphs -%}
<p>{{ paragraph.text | inline_html }}{% if paragraph.evidence %} <span class="time">{{ paragraph.evidence | evidence }}</span>{% endif %}</p>
{% endfor -%}
{% for action in section.actions -%}
<div class="task" data-semantic-id="{{ action.id }}"><span class="task-label">[{{ action.id }}] Tarea:</span> {{ action.outcome }} <span class="owner">(Responsable: {{ action.owner_display() }}; fecha: {{ action.due_display() }}).</span> <strong>Cierre:</strong> {{ action.acceptance }} <span class="time">{{ action.evidence | evidence }}</span></div>
{% endfor -%}
</section>
{% endfor %}
{% if acta.decisions %}<section class="section"><h2 class="section-title">Decisiones</h2>{% for item in acta.decisions %}<p data-semantic-id="{{ item.id }}"><strong>[{{ item.id }}]</strong> {{ item.statement }} <span class="time">{{ item.evidence | evidence }}</span></p>{% endfor %}</section>{% endif %}
{% if acta.proposals %}<section class="section"><h2 class="section-title">Propuestas abiertas</h2>{% for item in acta.proposals %}<p data-semantic-id="{{ item.id }}"><strong>[{{ item.id }}]</strong> {{ item.statement }} <span class="time">{{ item.evidence | evidence }}</span></p>{% endfor %}</section>{% endif %}
{% if acta.risks or acta.open_questions %}<section class="section"><h2 class="section-title">Riesgos y preguntas abiertas</h2>{% for item in acta.risks %}<p data-semantic-id="{{ item.id }}"><strong>[{{ item.id }}] Riesgo:</strong> {{ item.statement }} <span class="time">{{ item.evidence | evidence }}</span></p>{% endfor %}{% for item in acta.open_questions %}<p data-semantic-id="{{ item.id }}"><strong>[{{ item.id }}] Pregunta:</strong> {{ item.question }} <span class="time">{{ item.evidence | evidence }}</span></p>{% endfor %}</section>{% endif %}
{% if acta.prior_follow_ups %}<section class="section"><h2 class="section-title">Seguimiento del acta anterior</h2><table><thead><tr><th>Compromiso</th><th>Estado</th><th>Detalle</th></tr></thead><tbody>{% for item in acta.prior_follow_ups %}<tr><td>{{ item.item }}</td><td>{{ item.status_label() }}</td><td>{{ item.detail }}{% if item.evidence %} <span class="time">{{ item.evidence | evidence }}</span>{% endif %}</td></tr>{% endfor %}</tbody></table></section>{% endif %}
<div class="callout"><h2>Acuerdos y próximos pasos</h2><ul>{% for section in acta.sections %}{% for action in section.actions %}<li><strong>[{{ action.id }}]</strong> {{ action.outcome }} — {{ action.owner_display() }}; {{ action.due_display() }}.</li>{% endfor %}{% endfor %}</ul></div>
{% if acta.quality_warnings %}<section class="section"><h2 class="section-title">Limitaciones</h2>{% for warning in acta.quality_warnings %}<p>{{ warning.note }}{% if warning.evidence %} <span class="time">{{ warning.evidence | evidence }}</span>{% endif %}</p>{% endfor %}</section>{% endif %}
<div class="source-note">{{ acta.sources_note }}<div class="confidential">{{ branding.confidentiality_label }}</div></div>
{% if branding.footer_text or branding.page_numbers %}<div class="print-footer">{% if branding.footer_text %}{{ branding.footer_text }}{% endif %}{% if branding.footer_text and branding.page_numbers %} · {% endif %}{% if branding.page_numbers %}Página <span class="page-number"></span>{% endif %}</div>{% endif %}
</body></html>
